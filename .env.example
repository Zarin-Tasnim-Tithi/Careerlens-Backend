# ---- CareerLens API environment (copy to .env and fill in; never commit .env) ----
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name, e.g. /careerlens
MONGODB_URI=mongodb+srv://zarintasnim0018_db_user:udnJYYUUABYi9JdF@cluster0.piyw3cr.mongodb.net/

# Browser origin(s) allowed by CORS, comma-separated. Local Vite dev server + deployed Vercel URL.
CLIENT_URL=http://localhost:5173

# Long random secret, server-only. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=stkfstuoescnmljd
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Refresh cookie: "lax" when the frontend calls the API through the Vercel /api rewrite (recommended),
# "none" when the browser calls the Render URL directly (cross-site). "none" requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# No email provider is configured. When true, /auth/forgot-password returns the reset token for testing.
# Set to false in production (the token is then only written to the server log).
EXPOSE_RESET_TOKEN=true

MAX_UPLOAD_MB=8
AUTH_RATE_LIMIT=50
API_DOCS_PUBLIC=true

# ---- Seeding (npm run seed) ----
ADMIN_EMAIL=admin@careerlens.demo
ADMIN_PASSWORD=Career@2026
SEED_DEMO_DATA=true
DEMO_PASSWORD=<password-for-demo-student-and-recruiter>
